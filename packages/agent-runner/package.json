{
  "name": "@kove-advanced/agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "kove-advanced-agent": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "wow-eval": "pnpm build && node dist/wow-eval-cli.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@kove-advanced/agent": "workspace:*",
    "@kove-advanced/core": "workspace:*",
    "@kove-advanced/creation-schema": "workspace:*",
    "@playwright/test": "1.60.0",
    "vite": "5.4.21"
  }
}
