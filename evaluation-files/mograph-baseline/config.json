{
  "version": "kove.mograph.metrics.v1",
  "measurement": {
    "sampleFps": 6,
    "frameWidth": 96,
    "frameHeight": 54,
    "sceneThreshold": 0.25,
    "cutDedupeSeconds": 0.1,
    "ignoreCutsBeforeSeconds": 0.1,
    "lowMotionFloor": 5.0,
    "burstWindowSeconds": 1.0,
    "burstStepSeconds": 0.1
  },
  "thresholds": {
    "editMeanMotion": {
      "min": 31,
      "max": 55
    },
    "first4sMeanMotion": {
      "min": 25
    },
    "first4sHardCuts": {
      "max": 0
    },
    "burst": {
      "minCutsPerSecond": 2,
      "minDurationSeconds": 6,
      "startFraction": 0.25,
      "endFraction": 0.8
    },
    "maxStaticCompositionSeconds": {
      "max": 1.0
    },
    "hold": {
      "count": 1,
      "durationSeconds": {
        "min": 1.5,
        "max": 2.5
      },
      "startFraction": 0.75
    }
  },
  "videos": [
    {
