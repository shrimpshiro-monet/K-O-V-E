          "width": 0.125,
          "height": 0.13
        },
        {
          "label": "tiktok-watermark-bottom-right",
          "x": 0.875,
          "y": 0.86,
          "width": 0.125,
          "height": 0.14
        }
      ]
    },
    {
      "id": "curry56-scrapbook",
