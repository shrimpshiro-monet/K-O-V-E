# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Frame analysis backends (optional; without them analysis is unavailable).
# Point at a deployed engine or frame-worker — never at localhost, which in a
# deployed build resolves to the visitor's machine. Dev builds fall back to
# http://localhost:8000/analyze-frames on their own.
VITE_ECO_WORKER_URL=
VITE_VISION_WORKER_URL=

# Tokens for those backends, if they were configured with one
# (KOVE_ENGINE_TOKEN on the engine, WORKER_AUTH_TOKEN on the frame-worker).
# These end up in the bundle: a speed bump against casual abuse, not a secret.
VITE_ECO_WORKER_TOKEN=
VITE_VISION_WORKER_TOKEN=
