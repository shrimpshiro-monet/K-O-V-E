# Client env for the web app.
#
# SECURITY RULE: no provider secret may ever be a VITE_* variable — the CI
# gate scripts/check-vite-secrets.mjs fails the build on any VITE_* name
# matching /KEY|TOKEN|SECRET|PASSWORD/i. Cloudflare Workers AI credentials
# are server-side only (Pages secrets in prod; .dev.vars read by the Vite dev
# proxy in dev; Electron main-process env on desktop). Do NOT add
# CLOUDFLARE_* variables here.

# PostHog Analytics (optional; the project key is public by design)
VITE_POSTHOG_CLIENT_ID=
VITE_PUBLIC_POSTHOG_HOST=
