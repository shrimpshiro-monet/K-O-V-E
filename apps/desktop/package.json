{
  "name": "@kove-advanced/desktop",
  "private": true,
  "version": "1.0.0-alpha.17",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "bin": {
    "kove-advanced-mcp": "dist/mcp-shim/index.js"
  },
  "homepage": "https://kove-advanced.video",
  "author": {
    "name": "Kove Advanced",
    "email": "support@kove-advanced.video"
  },
  "description": "Kove Advanced — open-source professional video editor",
  "scripts": {
    "build:main": "node scripts/prepare-aurora-native.mjs && tsup",
    "build:renderer": "KOVE_ADVANCED_DESKTOP=1 pnpm --filter @kove-advanced/web build",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "predev": "pnpm run build:renderer",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:aurora": "node scripts/prepare-aurora-native.mjs",
    "pack": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder --dir",
    "dist": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
