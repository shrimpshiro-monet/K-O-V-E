.wrangler/


mobile-mockup/
# Xcode user data
xcuserdata/
*.xcuserstate



# Signing certs — never commit
*.p12
*.pfx
.dev.vars

# Eval harness reports (generated by KOVE_EVAL_BASELINE=1; never committed)
evaluation-files/baseline-*.json

# Vision e2e assets (MediaPipe runtime + models; fetched from npm by e2e/setup-assets.mjs)
apps/web/e2e/.assets/
apps/web/test-results/
apps/web/playwright-report/

# Craft-eval golden media: generated from seeds by `kove-eval build`, ~100MB and
# reproducible, so it stays out of the tree. What IS committed is the scorecard:
# baseline.json holds the numbers every later step has to beat, and the
# groundtruth.json files record what each fixture was constructed to contain.
evaluation-files/craft/packs/
evaluation-files/craft/tracks/
evaluation-files/craft/references/*.mp4
evaluation-files/craft/references/*-voice.wav
evaluation-files/craft/runs/
evaluation-files/craft/.cache/
evaluation-files/craft/**/sensitivity/
