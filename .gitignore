.wrangler/


mobile-mockup/
# Xcode user data
xcuserdata/
*.xcuserstate



# Signing certs — never commit
*.p12
*.pfx
.dev.vars

# Eval harness reports (generated by KOVE_EVAL_BASELINE=1 or the live-stub
# spec; never committed), plus their .failures/ sidecar directories — plans
# are artifacts, not source.
evaluation-files/baseline-*.json*
evaluation-files/eval-live-stub-report.json

# Vision e2e assets (MediaPipe runtime + models; fetched from npm by e2e/setup-assets.mjs)
apps/web/e2e/.assets/
apps/web/test-results/
apps/web/playwright-report/

# Local eval-corpus overlays + real-media evaluation assets — these are
# per-machine (KOVE_EVAL_ROOT; see evaluation-files/README.md). Copyrighted
# footage and multi-hundred-MB media must never enter git history.
/evaluation-files/*.local.json
/evaluation-files/*.mp4
/evaluation-files/audio/

# Local toolchain + session scratch (never source)
**/.venv/
session-*.md
tree.md
