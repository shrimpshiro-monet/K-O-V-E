# Project-specific
/public/projects/
*.kove-advanced
!apps/desktop/crates/kove-advanced-project/tests/fixtures/*.kove-advanced
apps/cloud/node_modules/
apps/cloud/dist/
apps/cloud/.wrangler/
apps/ios
apps/android

# Desktop bundled ffmpeg binaries (large; fetched/built per-platform, documented in MANIFEST.json)
apps/desktop/resources/bin/**/ffmpeg
apps/desktop/resources/bin/**/ffmpeg.exe

# Desktop bundled Blender sidecars (large; fetched/built per-platform, documented in apps/desktop/RIGGING.md)
apps/desktop/resources/rigging/blender/

# Desktop electron-builder output
apps/desktop/release/

# Desktop electron-builder config lives under build/ which the global build/ rule ignores
!apps/desktop/build/
!apps/desktop/build/**



# Local files
FEATURES_TWITTER.md
.claude-tasks.md
CLAUDE.md
*-PLAN.md
*-PLAN-*.md
